# HANS Proof of Concept - Example Environment File
# Copy this file to .env and fill in your own values.
# Do not commit the real .env file to GitHub.



# Embedding service
EMBEDDING_PROVIDER=cohere
COHERE_EMBED_MODEL=embed-multilingual-v3.0
EMBEDDING_DIMENSION=1024


# Reranking service
COHERE_API_KEY=replace_with_your_cohere_key
# Reranking model
RERANK_MODEL=rerank-english-v3.0

# Generation / validation services
ANTHROPIC_API_KEY=replace_with_your_anthropic_key

# --- Knowledge base ---
KB_VERSION=htw_en_kb_2026-01-25
MANIFEST_PATH=output/objects_manifest.jsonl

# Optional vector database
QDRANT_URL=replace_with_qdrant_url_if_used
QDRANT_API_KEY=replace_with_qdrant_key_if_used
QDRANT_COLLECTION=htw_documents_cohere_1024

#GENERATION_PROVIDER=cohere
#GENERATION_PROVIDER=anthropic
#GENERATION_MODEL=claude-3-haiku-20240307 #retired by anthrophic on april 20 2026, replcement as below
#GENERATION_MODEL=claude-haiku-4-5-20251001

# Mistral generation provider
MISTRAL_API_KEY=your_mistral_api_key_here
GENERATION_PROVIDER=mistral
GENERATION_MODEL=mistral-small-latest

# Optional PostgreSQL logging
POSTGRES_URL=
# --- Backend URL ---
BACKEND_URL=http://127.0.0.1:8001

# Disclaimer file
DISCLAIMER_PATH=config/disclaimer.md